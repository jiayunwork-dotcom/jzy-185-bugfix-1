# ── 通用基线（所有语言）──
# 依赖与构建产物
node_modules/
venv/
.venv/
__pycache__/
*.pyc
dist/
build/
*.egg-info/

# 模型在容器里现下的工具链落点（与语言无关，常是超 100MB 的元凶）。
# 只忽略工具链目录本身，不用 *.tar.gz/*.zip 这类宽通配——那会误伤合法的小体积测试夹具。
# 超大压缩包/二进制由 collect 的「大文件硬闸」在 push 前兜底拦截。
# 落点靠「猜目录名」注定挂一漏万（JZY-010 就把 JDK 下到了 tools/ 不带点，漏过 .tools/）。
# 这里补常见工具链落点，但只匹配「明确是下载来的运行时/依赖缓存」的目录，不忽略整个
# tools/（合法项目常在 tools/ 放小体积脚本，全忽略会误伤业务代码、拉低改动量踩 G11）。
# 真正兜底仍是防线2（不挑路径、只看 >=95MB 大小）。
.tools/
toolchain/
.toolchain/
# 下载解压的 JDK/JRE（无论落在根还是任意子目录）
jdk/
jre/
**/jdk-*/
**/jdk[0-9]*/
tools/jdk*/
tools/*.tar.gz
tools/*.zip
# 依赖/构建缓存（本机缓存，不该进产物）
.m2/repository/
.gradle/caches/

# 环境与密钥
.env
*.key
*.pem
auth.env

# IDE / 系统
.vscode/
.idea/
*.swp
.DS_Store
